# Copy to .env.production.local. These two values are public browser configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Toss secret keys must only be entered in Supabase Edge Function Secrets.
# Never add server secrets to VITE_ variables.
# Supabase Edge Function Secrets also need TOSS_CLIENT_KEY, TOSS_SECRET_KEY,
# TOSS_LIVE_ENABLED=0, PAID_FEATURES_READY=0, and MOA_AI_READY=0 by default.

# Optional: set only after deploying and verifying the Cloudflare photo edit Worker.
# Public URL, e.g. https://moa-photo-edit.YOUR_SUBDOMAIN.workers.dev
VITE_PHOTO_EDIT_API_URL=

# Public Turnstile widget key; configure matching secret in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=

# GitHub Actions Supabase backup secrets. Do not put these in VITE_ variables.
SUPABASE_DB_URL=postgresql://postgres:REPLACE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_ME
BACKUP_DESTINATION_URI=s3://YOUR_PRIVATE_BACKUP_BUCKET/moa-studio/supabase
BACKUP_AWS_ACCESS_KEY_ID=REPLACE_ME
BACKUP_AWS_SECRET_ACCESS_KEY=REPLACE_ME
BACKUP_AWS_REGION=us-west-004

# Optional for S3-compatible providers such as Backblaze B2 or Cloudflare R2.
# Use an HTTPS origin only, without credentials, bucket path, query, or hash.
# Leave unset for standard AWS S3.
BACKUP_AWS_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
