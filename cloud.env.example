# Copy to .env.production.local. These two values are public browser configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Toss secret keys must only be entered in Supabase Edge Function Secrets.
# Never add server secrets to VITE_ variables.
# Supabase Edge Function Secrets also need TOSS_CLIENT_KEY, TOSS_SECRET_KEY,
# TOSS_LIVE_ENABLED=0, PAID_FEATURES_READY=0, and MOA_AI_READY=0 by default.

# Optional: set only after deploying and verifying the Cloudflare photo edit Worker.
# Public URL, e.g. https://moa-photo-edit.YOUR_SUBDOMAIN.workers.dev
VITE_PHOTO_EDIT_API_URL=
