# Copy to .env.production on the production server and fill values privately.
# Use this same file with: docker compose --env-file .env.production up -d --build

APP_DOMAIN=
PUBLIC_APP_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Toss Payments live keys from the Softbuild shop.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Keep disabled until HTTPS, live keys, support policy, and real merchant readiness are verified.
TOSS_LIVE_ENABLED=0
# Keep disabled until paid entitlements and AI delivery have been verified end-to-end.
PAID_FEATURES_READY=0
MOA_AI_READY=0

MOA_SECURE_COOKIES=1
