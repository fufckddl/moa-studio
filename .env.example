# Keep disabled until production service, merchant contract and HTTPS are ready.
TOSS_LIVE_ENABLED=0
# Keep both disabled until paid entitlements and AI delivery have been verified end-to-end.
PAID_FEATURES_READY=0
MOA_AI_READY=0
MOA_SECURE_COOKIES=0
